FROM python:3.12-slim
WORKDIR /app

COPY mcp-http/requirements.txt mcp-http/requirements.txt
RUN pip install --no-cache-dir -r mcp-http/requirements.txt

COPY SKILL.md SKILL.md
COPY scripts scripts
COPY mcp mcp
COPY mcp-http mcp-http

ENV ERPCLAW_DB_DIALECT=postgresql
ENV PORT=8080
EXPOSE 8080

WORKDIR /app/mcp-http
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT}"]
